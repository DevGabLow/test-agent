package runner;

import org.junit.platform.suite.api.ConfigurationParameter;
import org.junit.platform.suite.api.IncludeEngines;
import org.junit.platform.suite.api.SelectClasspathResource;
import org.junit.platform.suite.api.Suite;

import static io.cucumber.junit.platform.engine.Constants.FILTER_TAGS_PROPERTY_NAME;
import static io.cucumber.junit.platform.engine.Constants.GLUE_PROPERTY_NAME;
import static io.cucumber.junit.platform.engine.Constants.PLUGIN_PROPERTY_NAME;

/**
 * Cucumber Test Suite — JUnit 5 + Cucumber Platform Engine.
 * <p>
 * Esta classe NÃO usa {@code @RunWith(Cucumber.class)} nem {@code @CucumberOptions},
 * que são APIs do JUnit 4. Em vez disso, usa anotações do JUnit Platform Suite
 * com {@code @ConfigurationParameter} para configurar o Cucumber.
 * </p>
 *
 * <p><b>Para executar:</b></p>
 * <pre>
 * # Todos os cenários (exceto @ignore)
 * mvn test
 *
 * # Feature específica
 * mvn test -Dcucumber.filter.tags="@pet"
 *
 * # Tags combinadas
 * mvn test -Dcucumber.filter.tags="@happy and not @ignore"
 * </pre>
 */
@Suite
@IncludeEngines("cucumber")
@SelectClasspathResource("features")
@ConfigurationParameter(key = GLUE_PROPERTY_NAME, value = "steps, hooks, context, runner")
@ConfigurationParameter(key = PLUGIN_PROPERTY_NAME,
        value = "pretty, " +
                "html:target/cucumber-reports/cucumber.html, " +
                "json:target/cucumber-reports/cucumber.json")
@ConfigurationParameter(key = FILTER_TAGS_PROPERTY_NAME, value = "not @ignore")
public class CucumberTestSuite {
    // Classe vazia — toda configuração é feita via anotações.
    // O Cucumber descobre automaticamente as features em src/test/resources/features/
    // e as step definitions nos pacotes configurados em GLUE_PROPERTY_NAME.
}
